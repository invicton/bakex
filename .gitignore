# BakeX runtime data (never commit credentials or build artifacts)
data/credentials.enc
# Match ANY key/salt name, not just the current brand's. Each past rename left the
# previous generation's key file unignored and it got committed (.stratum_key,
# .invicton_key, .statim_key); these globs mean the next rename cannot repeat that.
data/.*_key
data/.*_salt
data/.admin_token
data/audits/
data/builds/
data/local-images/
data/scap-content/
data/audit_jobs.json
data/api_keys.json
data/webhooks.json
profiles/community/
profiles/user/

